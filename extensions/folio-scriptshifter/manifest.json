{
  "manifest_version": 3,
  "name": "ScriptShifter for FOLIO",
  "version": "0.10.1",
  "description": "Preview ScriptShifter transliterations and add Unicode diacritics offline in FOLIO form fields.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://bibframe.org/*"
  ],
  "action": {
    "default_title": "Open ScriptShifter for FOLIO"
  },
  "author": "Ayman El-Masry",
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  }
}
